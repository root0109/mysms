{
  "name": "clients",
  "private": true,
  "description": "MySMS client workspace: web, platform console, mobile (student/parent/teacher) and tablet apps on one SDK and shared packages.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "generate": "turbo run generate",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "verify": "prettier --check . && turbo run generate typecheck lint test build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "pnpm": {
    "overrides": {
      "react": "19.1.10",
      "react-dom": "19.1.10",
      "@types/react": "19.1.17"
    },
    "ignoredBuiltDependencies": [
      "@openapitools/openapi-generator-cli"
    ]
  }
}
