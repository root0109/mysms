{
  "name": "@mysms/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "MySMS API clients generated by OpenAPI Generator (typescript-fetch) from api/openapi, one per module. Never edited by hand.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/generated/runtime.ts",
    "./*": "./src/generated/*.ts"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint --max-warnings 0 src scripts"
  },
  "devDependencies": {
    "@mysms/config": "workspace:*",
    "@openapitools/openapi-generator-cli": "2.42.0",
    "typescript": "5.9.3"
  }
}
