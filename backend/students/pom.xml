<?xml version="1.0" encoding="UTF-8"?>
<!--
  students: the Students microservice (docs/design/MODULE-AND-PRODUCT-REORGANISATION.md §3). Its areas "sis", "admission", "careers" each own
  their database schema of the same name, contract (com.mysms.<area>.v1, /v1/<area>), operation table and Flyway
  history (database/migrations/<area>); inside the module they share one process, one jar and one gRPC server.
  Depends on core, auth-client and the messaging runtime; only event consumers compile against the narrow messaging
  API. Produces a plain jar (assembled by `app`) and an executable microservice jar (classifier exec).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.mysms</groupId>
    <artifactId>mysms</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>students</artifactId>
  <name>MySMS students</name>
  <description>Students microservice (schemas sis, admission, careers)</description>

  <properties>
    <!-- SpotBugs analyses the module's own code: its root package and every layer package of each area (§3) -->
    <mysms.spotbugs.onlyAnalyze>com.mysms.students.*,com.mysms.students.sis.*,com.mysms.students.sis.api.-,com.mysms.students.sis.controller.-,com.mysms.students.sis.grpc.-,com.mysms.students.sis.integration.-,com.mysms.students.sis.business.-,com.mysms.students.sis.repository.-,com.mysms.students.sis.domain.-,com.mysms.students.sis.model.-,com.mysms.students.sis.mapper.-,com.mysms.students.sis.validation.-,com.mysms.students.sis.errors.-,com.mysms.students.sis.events.-,com.mysms.students.sis.config.-,com.mysms.students.sis.constants.-,com.mysms.students.admission.*,com.mysms.students.admission.api.-,com.mysms.students.admission.controller.-,com.mysms.students.admission.grpc.-,com.mysms.students.admission.integration.-,com.mysms.students.admission.business.-,com.mysms.students.admission.repository.-,com.mysms.students.admission.domain.-,com.mysms.students.admission.model.-,com.mysms.students.admission.mapper.-,com.mysms.students.admission.validation.-,com.mysms.students.admission.errors.-,com.mysms.students.admission.events.-,com.mysms.students.admission.config.-,com.mysms.students.admission.constants.-,com.mysms.students.careers.*,com.mysms.students.careers.api.-,com.mysms.students.careers.controller.-,com.mysms.students.careers.grpc.-,com.mysms.students.careers.integration.-,com.mysms.students.careers.business.-,com.mysms.students.careers.repository.-,com.mysms.students.careers.domain.-,com.mysms.students.careers.model.-,com.mysms.students.careers.mapper.-,com.mysms.students.careers.validation.-,com.mysms.students.careers.errors.-,com.mysms.students.careers.events.-,com.mysms.students.careers.config.-,com.mysms.students.careers.constants.-</mysms.spotbugs.onlyAnalyze>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>auth-client</artifactId>
    </dependency>
    <!-- privacy's rights-request tasks and retention runs (PrivacyTaskHandler) -->
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>privacy-client</artifactId>
    </dependency>
    <dependency>
      <groupId>org.mapstruct</groupId>
      <artifactId>mapstruct</artifactId>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- messaging runtime relay; event consumers compile against its narrow API -->
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>messaging</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-mail</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>core</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>auth-client</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>privacy-client</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- each area's migrations, from the single source of truth, applied to its own schema only -->
      <resource>
        <directory>${mysms.migrations.dir}/sis</directory>
        <targetPath>db/migration/sis</targetPath>
      </resource>
      <resource>
        <directory>${mysms.migrations.dir}/admission</directory>
        <targetPath>db/migration/admission</targetPath>
      </resource>
      <resource>
        <directory>${mysms.migrations.dir}/careers</directory>
        <targetPath>db/migration/careers</targetPath>
      </resource>
    </resources>
    <plugins>
      <!-- its protos (src/main/resources/proto: its areas' own, and copies of the callees' they call) into its jar -->
      <plugin>
        <groupId>org.xolstice.maven.plugins</groupId>
        <artifactId>protobuf-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.mysms.students.StudentsApplication</mainClass>
          <classifier>exec</classifier>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
