<?xml version="1.0" encoding="UTF-8"?>
<!--
  app: assembly ONLY (JAVA-CODING-RULES §2). One main class running all 21 modules in one process with merged
  configuration. No business code, no schema, no migrations of its own. Each module keeps its own pool, transaction
  manager and Flyway history inside the monolith, exactly as when it runs alone.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.mysms</groupId>
    <artifactId>mysms</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>app</artifactId>
  <name>MySMS monolith</name>

  <dependencies>
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>master</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>platform</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>iam</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>org</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>people</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>academics</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>sis</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>hr</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>payroll</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>admission</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>attendance</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>facility</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>timetable</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>assessment</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>lms</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>finance</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>library</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>transport</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>comms</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>frontoffice</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>careers</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>core</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>auth-client</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.mysms.app.MySmsApplication</mainClass>
          <classifier>exec</classifier>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
