<?xml version="1.0" encoding="UTF-8"?>
<!--
  Local build cache (see .mvn/extensions.xml). A module is restored only when every input is unchanged: its sources
  and resources (main, test, component-test), its POM and the checksums of its dependencies, including the other MySMS
  modules it builds on. Besides the jar, a hit restores the files later steps read from target/: the OpenAPI document
  the component test writes (target/openapi/<area>/api-docs.yml, input of the clients' TypeScript SDK) and the gRPC
  descriptor set (target/docs/protos).
-->
<cache xmlns="http://maven.apache.org/BUILD-CACHE-CONFIG/1.2.0"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://maven.apache.org/BUILD-CACHE-CONFIG/1.2.0 https://maven.apache.org/xsd/build-cache-config-1.2.0.xsd">
  <configuration>
    <enabled>true</enabled>
    <hashAlgorithm>XX</hashAlgorithm>
    <attachedOutputs>
      <dirNames>
        <dirName>openapi</dirName>
        <dirName>docs</dirName>
      </dirNames>
    </attachedOutputs>
  </configuration>
  <input>
    <global>
      <glob>{*.java,*.xml,*.properties,*.yml,*.yaml,*.json,*.sql,*.proto,*.md,*.txt}</glob>
      <includes>
        <include>src/</include>
      </includes>
    </global>
  </input>
</cache>
