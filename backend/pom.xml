<?xml version="1.0" encoding="UTF-8"?>
<!--
  MySMS backend: reactor and parent POM (JAVA-CODING-RULES §2).
  Flat modules, one per database schema; every version and plugin is pinned here and nowhere else.
    mvn verify                      every module: compile, unit + component tests, Checkstyle, SpotBugs, JaCoCo
    mvn -pl finance -am package     the finance microservice (finance/target/finance-*-exec.jar)
    mvn -pl app -am package         the monolith (app/target/app-*-exec.jar)
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>com.mysms</groupId>
  <artifactId>mysms</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>MySMS</name>
  <description>MySMS education management system: 22 domain microservices that also assemble into one monolith.</description>

  <modules>
    <module>core</module>
    <module>auth-client</module>
    <module>messaging</module>
    <module>privacy-client</module>
    <module>master</module>
    <module>platform</module>
    <module>iam</module>
    <module>org</module>
    <module>people</module>
    <module>academics</module>
    <module>sis</module>
    <module>hr</module>
    <module>payroll</module>
    <module>admission</module>
    <module>attendance</module>
    <module>facility</module>
    <module>timetable</module>
    <module>assessment</module>
    <module>lms</module>
    <module>finance</module>
    <module>library</module>
    <module>transport</module>
    <module>comms</module>
    <module>frontoffice</module>
    <module>careers</module>
    <module>privacy</module>
    <module>app</module>
    <module>demo-seed</module>
    <module>conformance</module>
  </modules>

  <properties>
    <java.version>17</java.version>
    <maven.compiler.release>${java.version}</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <mysms.migrations.dir>${maven.multiModuleProjectDirectory}/../database/migrations</mysms.migrations.dir>
    <mysms.config.dir>${maven.multiModuleProjectDirectory}/config</mysms.config.dir>

    <!-- versions not managed by Spring Boot (Spring Boot 4.1.2 manages Spring, Jackson, Flyway, PostgreSQL,
         HikariCP, Testcontainers, JUnit, Lombok and the standard Maven plugins; Spring Boot's parent manages the gRPC and protobuf versions) -->
    <!-- the gRPC server and the @GrpcClient stubs of every module, the reference service's mechanism (net.devh);
         the newest release, which runs on Spring Boot 4 -->
    <grpc-spring-boot-starter.version>3.1.0.RELEASE</grpc-spring-boot-starter.version>
    <!-- each module compiles its own protos (and its copies of the callees'), the reference service's mechanism:
         protoc + protoc-gen-grpc-java resolved by OS -->
    <xolstice-protobuf-maven-plugin.version>0.6.1</xolstice-protobuf-maven-plugin.version>
    <os-maven-plugin.version>1.7.1</os-maven-plugin.version>
    <!-- Jackson, pinned above Spring Boot's managed versions the reference service's way: jackson-bom.version is
         Jackson 3 (tools.jackson, every MySMS mapper), jackson-2-bom.version the Jackson 2 that libraries still bring -->
    <jackson-bom.version>3.3.0</jackson-bom.version>
    <jackson-2-bom.version>2.23.0</jackson-2-bom.version>
    <springdoc.version>3.2.0</springdoc.version>
    <mapstruct.version>1.6.3</mapstruct.version>
    <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
    <exec-maven-plugin.version>3.6.4</exec-maven-plugin.version>
    <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
    <checkstyle.version>12.3.1</checkstyle.version>
    <spotbugs-maven-plugin.version>4.10.4.1</spotbugs-maven-plugin.version>
    <spotbugs.version>4.10.4</spotbugs.version>
    <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
    <google-cloud-pubsub.version>1.157.0</google-cloud-pubsub.version>
    <!-- platform's file store (signed upload/download URLs); the release train of google-cloud-pubsub above -->
    <google-cloud-storage.version>2.75.0</google-cloud-storage.version>
    <!-- argon2id password hashing in iam (JAVA-CODING-RULES §16 security floor) -->
    <bouncycastle.version>1.86</bouncycastle.version>
    <!-- google.rpc.Status / ErrorInfo / BadRequest / PreconditionFailure of gRPC errors (api/README "Errors"); the
         release the Pub/Sub client brings, so every module resolves one copy -->
    <proto-google-common-protos.version>2.78.0</proto-google-common-protos.version>

    <!-- quality gates (JAVA-CODING-RULES §12, §13) -->
    <mysms.coverage.line.minimum>0.80</mysms.coverage.line.minimum>
    <checkstyle.skip>false</checkstyle.skip>
    <spotbugs.skip>false</spotbugs.skip>
    <jacoco.skip>false</jacoco.skip>
    <!--
      SpotBugs analyses a module's own code only. A domain module also compiles its own and its callees' protos
      (com.mysms.<module>.v1): thousands of generated classes that took lms past SpotBugs' timeout. The list is the
      module's root package and the layer packages of JAVA-CODING-RULES §3 (ModuleBoundaryRule checks that it names
      every layer); the shared modules, which have no layer packages, set their own root package.
    -->
    <mysms.spotbugs.onlyAnalyze>com.mysms.${project.artifactId}.*,com.mysms.${project.artifactId}.api.-,com.mysms.${project.artifactId}.controller.-,com.mysms.${project.artifactId}.grpc.-,com.mysms.${project.artifactId}.integration.-,com.mysms.${project.artifactId}.business.-,com.mysms.${project.artifactId}.repository.-,com.mysms.${project.artifactId}.domain.-,com.mysms.${project.artifactId}.model.-,com.mysms.${project.artifactId}.mapper.-,com.mysms.${project.artifactId}.validation.-,com.mysms.${project.artifactId}.errors.-,com.mysms.${project.artifactId}.events.-,com.mysms.${project.artifactId}.config.-,com.mysms.${project.artifactId}.constants.-</mysms.spotbugs.onlyAnalyze>
    <!--
      Test JVM: JaCoCo's prepare-agent appends its agent to argLine (empty when JaCoCo is skipped). The heap is capped so
      that two module test JVMs of the parallel build (-T 1C), the Maven JVM and the PostgreSQL containers fit in the
      build machine's memory; C1-only JIT because short-lived test JVMs gain nothing from C2 and pay for it in CPU.
    -->
    <argLine/>
    <mysms.test.jvm>-Xmx1g -XX:TieredStopAtLevel=1</mysms.test.jvm>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- one gRPC and one protobuf release for every module (the versions Spring Boot pins, through their BOMs), so
           every jar's generated stubs come from the same protoc and run on the same runtime -->
      <dependency>
        <groupId>io.grpc</groupId>
        <artifactId>grpc-bom</artifactId>
        <version>${grpc-java.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.google.protobuf</groupId>
        <artifactId>protobuf-bom</artifactId>
        <version>${protobuf-java.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- the gRPC server (@GrpcService, @GrpcGlobalServerInterceptor) and clients (@GrpcClient,
           @GrpcGlobalClientInterceptor) on plain Netty, as the reference service runs them -->
      <dependency>
        <groupId>net.devh</groupId>
        <artifactId>grpc-spring-boot-starter</artifactId>
        <version>${grpc-spring-boot-starter.version}</version>
        <exclusions>
          <exclusion>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-netty-shaded</artifactId>
          </exclusion>
        </exclusions>
      </dependency>
      <dependency>
        <groupId>org.bouncycastle</groupId>
        <artifactId>bcprov-jdk18on</artifactId>
        <version>${bouncycastle.version}</version>
      </dependency>
      <!-- a real SMTP server for iam's mail component tests (JAVA-CODING-RULES §12: adapters against the protocol) -->
      <dependency>
        <groupId>com.icegreen</groupId>
        <artifactId>greenmail</artifactId>
        <version>2.1.12</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>com.mysms</groupId>
        <artifactId>core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.mysms</groupId>
        <artifactId>core</artifactId>
        <version>${project.version}</version>
        <type>test-jar</type>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
      <dependency>
        <groupId>com.mysms</groupId>
        <artifactId>auth-client</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.mysms</groupId>
        <artifactId>auth-client</artifactId>
        <version>${project.version}</version>
        <type>test-jar</type>
      </dependency>
      <dependency>
        <groupId>com.mysms</groupId>
        <artifactId>privacy-client</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.mysms</groupId>
        <artifactId>privacy-client</artifactId>
        <version>${project.version}</version>
        <type>test-jar</type>
      </dependency>
      <dependency>
        <groupId>com.mysms</groupId>
        <artifactId>messaging</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.google.cloud</groupId>
        <artifactId>google-cloud-pubsub</artifactId>
        <version>${google-cloud-pubsub.version}</version>
      </dependency>
      <dependency>
        <groupId>com.google.cloud</groupId>
        <artifactId>google-cloud-storage</artifactId>
        <version>${google-cloud-storage.version}</version>
      </dependency>
      <dependency>
        <groupId>org.mapstruct</groupId>
        <artifactId>mapstruct</artifactId>
        <version>${mapstruct.version}</version>
      </dependency>
      <dependency>
        <groupId>com.google.api.grpc</groupId>
        <artifactId>proto-google-common-protos</artifactId>
        <version>${proto-google-common-protos.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!-- test stack shared by every module -->
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <extensions>
      <!-- resolves protoc and protoc-gen-grpc-java for the building machine's OS (the reference service's setup) -->
      <extension>
        <groupId>kr.motd.maven</groupId>
        <artifactId>os-maven-plugin</artifactId>
        <version>${os-maven-plugin.version}</version>
      </extension>
    </extensions>
    <pluginManagement>
      <plugins>
        <!--
          Eclipse/STS (m2e) only: never run the quality gates in the IDE's automatic build. They need every module's
          runtime dependencies resolved and installed, and they run on the command line (mvn verify / mvn install).
          Maven itself never resolves this entry.
        -->
        <plugin>
          <groupId>org.eclipse.m2e</groupId>
          <artifactId>lifecycle-mapping</artifactId>
          <version>1.0.0</version>
          <configuration>
            <lifecycleMappingMetadata>
              <pluginExecutions>
                <pluginExecution>
                  <pluginExecutionFilter>
                    <groupId>com.github.spotbugs</groupId>
                    <artifactId>spotbugs-maven-plugin</artifactId>
                    <versionRange>[0,)</versionRange>
                    <goals>
                      <goal>check</goal>
                      <goal>spotbugs</goal>
                    </goals>
                  </pluginExecutionFilter>
                  <action>
                    <ignore/>
                  </action>
                </pluginExecution>
                <pluginExecution>
                  <pluginExecutionFilter>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-checkstyle-plugin</artifactId>
                    <versionRange>[0,)</versionRange>
                    <goals>
                      <goal>check</goal>
                    </goals>
                  </pluginExecutionFilter>
                  <action>
                    <ignore/>
                  </action>
                </pluginExecution>
                <pluginExecution>
                  <pluginExecutionFilter>
                    <groupId>org.xolstice.maven.plugins</groupId>
                    <artifactId>protobuf-maven-plugin</artifactId>
                    <versionRange>[0,)</versionRange>
                    <goals>
                      <goal>compile</goal>
                      <goal>compile-custom</goal>
                    </goals>
                  </pluginExecutionFilter>
                  <action>
                    <ignore/>
                  </action>
                </pluginExecution>
                <pluginExecution>
                  <pluginExecutionFilter>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <versionRange>[0,)</versionRange>
                    <goals>
                      <goal>prepare-agent</goal>
                      <goal>report</goal>
                      <goal>check</goal>
                    </goals>
                  </pluginExecutionFilter>
                  <action>
                    <ignore/>
                  </action>
                </pluginExecution>
              </pluginExecutions>
            </lifecycleMappingMetadata>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <parameters>true</parameters>
            <!--
              -deprecation: Spring 7 deprecates org.springframework.lang.Nullable, used about 32,000 times in the
              generated-style API sources; javac kept one diagnostic per use in the shared Maven JVM, which ran it out
              of memory and buried real errors under the 100-message limit. Turn it back on after the move to
              org.jspecify.annotations.Nullable.
            -->
            <compilerArgs>
              <arg>-Xlint:all,-processing,-serial,-deprecation</arg>
            </compilerArgs>
            <!-- Lombok before MapStruct: MapStruct must see the Lombok-generated accessors (§2) -->
            <annotationProcessorPaths>
              <path>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
              </path>
              <path>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok-mapstruct-binding</artifactId>
                <version>${lombok-mapstruct-binding.version}</version>
              </path>
              <path>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${mapstruct.version}</version>
              </path>
            </annotationProcessorPaths>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <!-- unit (*Test) and component (*ComponentTest) run in mvn test; E2E only with -P e2e (§12) -->
            <includes>
              <include>**/*Test.java</include>
            </includes>
            <excludes>
              <exclude>**/*E2ETest.java</exclude>
            </excludes>
            <trimStackTrace>false</trimStackTrace>
            <argLine>@{argLine} ${mysms.test.jvm}</argLine>
            <systemPropertyVariables>
              <user.timezone>UTC</user.timezone>
            </systemPropertyVariables>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>${exec-maven-plugin.version}</version>
        </plugin>
        <!--
          A module's protos (src/main/resources/proto: its own, and verbatim copies of the callees' it calls) compiled
          into its jar: messages and the grpc-java stubs, plus the descriptor set (target/docs/protos/grpc.protobin).
          The protos of core (mysms/common) are on the import path from core's jar. A module enables it with a bare
          <plugin> entry; every version and setting is here (the reference service's configuration).
        -->
        <plugin>
          <groupId>org.xolstice.maven.plugins</groupId>
          <artifactId>protobuf-maven-plugin</artifactId>
          <version>${xolstice-protobuf-maven-plugin.version}</version>
          <configuration>
            <protocArtifact>com.google.protobuf:protoc:${protobuf-java.version}:exe:${os.detected.classifier}</protocArtifact>
            <pluginId>grpc-java</pluginId>
            <pluginArtifact>io.grpc:protoc-gen-grpc-java:${grpc-java.version}:exe:${os.detected.classifier}</pluginArtifact>
            <protoSourceRoot>${basedir}/src/main/resources/proto</protoSourceRoot>
          </configuration>
          <executions>
            <execution>
              <id>protobuf-compile</id>
              <goals>
                <goal>compile</goal>
                <goal>compile-custom</goal>
              </goals>
              <configuration>
                <writeDescriptorSet>true</writeDescriptorSet>
                <includeDependenciesInDescriptorSet>true</includeDependenciesInDescriptorSet>
                <includeSourceInfoInDescriptorSet>true</includeSourceInfoInDescriptorSet>
                <descriptorSetFileName>grpc.protobin</descriptorSetFileName>
                <descriptorSetOutputDirectory>${project.build.directory}/docs/protos</descriptorSetOutputDirectory>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-checkstyle-plugin</artifactId>
          <version>${maven-checkstyle-plugin.version}</version>
          <dependencies>
            <dependency>
              <groupId>com.puppycrawl.tools</groupId>
              <artifactId>checkstyle</artifactId>
              <version>${checkstyle.version}</version>
            </dependency>
          </dependencies>
          <configuration>
            <configLocation>${mysms.config.dir}/checkstyle/checkstyle.xml</configLocation>
            <suppressionsLocation>${mysms.config.dir}/checkstyle/suppressions.xml</suppressionsLocation>
            <propertyExpansion>config_loc=${mysms.config.dir}/checkstyle</propertyExpansion>
            <!-- hand-written code only: generated sources are never style-checked (§13) -->
            <sourceDirectories>
              <sourceDirectory>${project.basedir}/src/main/java</sourceDirectory>
            </sourceDirectories>
            <testSourceDirectories>
              <testSourceDirectory>${project.basedir}/src/test/java</testSourceDirectory>
              <testSourceDirectory>${project.basedir}/src/component-test/java</testSourceDirectory>
            </testSourceDirectories>
            <includeTestSourceDirectory>true</includeTestSourceDirectory>
            <consoleOutput>true</consoleOutput>
            <failOnViolation>true</failOnViolation>
            <violationSeverity>warning</violationSeverity>
          </configuration>
        </plugin>
        <plugin>
          <groupId>com.github.spotbugs</groupId>
          <artifactId>spotbugs-maven-plugin</artifactId>
          <version>${spotbugs-maven-plugin.version}</version>
          <dependencies>
            <dependency>
              <groupId>com.github.spotbugs</groupId>
              <artifactId>spotbugs</artifactId>
              <version>${spotbugs.version}</version>
            </dependency>
          </dependencies>
          <configuration>
            <effort>Max</effort>
            <onlyAnalyze>${mysms.spotbugs.onlyAnalyze}</onlyAnalyze>
            <threshold>Medium</threshold>
            <excludeFilterFile>${mysms.config.dir}/spotbugs/exclude.xml</excludeFilterFile>
            <!-- the generated proto classes are still loaded as referenced classes; the 512 MB default runs out of heap in lms -->
            <maxHeap>1536</maxHeap>
            <failOnError>true</failOnError>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco-maven-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- component tests live in their own source root and run with the unit tests (§12) -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>component-test-sources</id>
            <phase>generate-test-sources</phase>
            <goals>
              <goal>add-test-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.basedir}/src/component-test/java</source>
              </sources>
            </configuration>
          </execution>
          <execution>
            <id>component-test-resources</id>
            <phase>generate-test-resources</phase>
            <goals>
              <goal>add-test-resource</goal>
            </goals>
            <configuration>
              <resources>
                <resource>
                  <directory>${project.basedir}/src/component-test/resources</directory>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <executions>
          <execution>
            <?m2e ignore?>
            <id>checkstyle</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <executions>
          <execution>
            <?m2e ignore?>
            <id>spotbugs</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <!-- generated code is excluded from coverage (§13) -->
            <exclude>**/*MapperImpl.class</exclude>
            <!-- protobuf messages and grpc-java stubs, compiled from the module's protos -->
            <exclude>com/mysms/*/v1/**</exclude>
            <!-- the contract layer: declarative DTOs and interfaces; behaviour is covered through the controllers -->
            <exclude>com/mysms/*/api/**</exclude>
            <!-- main(): starts a server; every module's wiring is covered by its component test instead -->
            <exclude>**/*Application.class</exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <?m2e ignore?>
            <id>report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <?m2e ignore?>
            <id>check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <haltOnFailure>true</haltOnFailure>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${mysms.coverage.line.minimum}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!-- black-box tests against a deployed stack (§12); never part of the default build -->
      <id>e2e</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <includes>
                <include>**/*E2ETest.java</include>
              </includes>
              <excludes combine.self="override"/>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
