<?xml version="1.0" encoding="UTF-8"?>
<!--
  messaging-rabbitmq: the default implementation of core's EventBus (JAVA-CODING-RULES §4, DEPLOYMENT.md "Events").
  Modules never see it: they depend on core's events API, and on this module at runtime scope only, so no module
  code can import a RabbitMQ class. Another broker is another module implementing the same interface, chosen with
  mysms.events.bus. Hand-written, owned by the platform team.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.mysms</groupId>
    <artifactId>mysms</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>messaging-rabbitmq</artifactId>
  <name>MySMS messaging (RabbitMQ)</name>
  <dependencies>
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.rabbitmq</groupId>
      <artifactId>amqp-client</artifactId>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
