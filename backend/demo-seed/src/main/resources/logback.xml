<?xml version="1.0" encoding="UTF-8"?>
<!-- The seeder's console: its own progress at INFO, the HTTP client's and the libraries' chatter left out. -->
<configuration>
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss} %-5level %msg%n</pattern>
    </encoder>
  </appender>
  <root level="WARN">
    <appender-ref ref="CONSOLE"/>
  </root>
  <logger name="com.mysms.demoseed" level="INFO"/>
</configuration>
