<?xml version="1.0" encoding="UTF-8"?>
<!--
  conformance: the mechanical rules of JAVA-CODING-RULES.md, ARCHITECTURE.md and database/README.md that the compiler,
  Checkstyle and SpotBugs do not already enforce, checked over the whole repository as part of the build.
  Last in the reactor so it reads every module as built; its test fails the build on any violation.
  Plain Java: no Spring, no database (tenant tables are read from the migrations).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.mysms</groupId>
    <artifactId>mysms</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>conformance</artifactId>
  <name>MySMS conformance check</name>

  <dependencies>
    <!-- reads the API contracts (operation ids, permissions, security) -->
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
    </dependency>
  </dependencies>
</project>
