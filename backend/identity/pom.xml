<?xml version="1.0" encoding="UTF-8"?>
<!--
  identity: the Identity microservice (docs/design/MODULE-AND-PRODUCT-REORGANISATION.md §3). Its areas "iam", "people" each own
  their database schema of the same name, contract (com.mysms.<area>.v1, /v1/<area>), operation table and Flyway
  history (database/migrations/<area>); inside the module they share one process, one jar and one gRPC server.
  Depends on core, auth-client and the messaging runtime; only event consumers compile against the narrow messaging
  API. Produces a plain jar (assembled by `app`) and an executable microservice jar (classifier exec).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.mysms</groupId>
    <artifactId>mysms</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>identity</artifactId>
  <name>MySMS identity</name>
  <description>Identity microservice (schemas iam, people)</description>

  <properties>
    <!-- SpotBugs analyses the module's own code: its root package and every layer package of each area (§3) -->
    <mysms.spotbugs.onlyAnalyze>com.mysms.identity.*,com.mysms.identity.iam.*,com.mysms.identity.iam.api.-,com.mysms.identity.iam.controller.-,com.mysms.identity.iam.grpc.-,com.mysms.identity.iam.integration.-,com.mysms.identity.iam.business.-,com.mysms.identity.iam.repository.-,com.mysms.identity.iam.domain.-,com.mysms.identity.iam.model.-,com.mysms.identity.iam.mapper.-,com.mysms.identity.iam.validation.-,com.mysms.identity.iam.errors.-,com.mysms.identity.iam.events.-,com.mysms.identity.iam.config.-,com.mysms.identity.iam.constants.-,com.mysms.identity.people.*,com.mysms.identity.people.api.-,com.mysms.identity.people.controller.-,com.mysms.identity.people.grpc.-,com.mysms.identity.people.integration.-,com.mysms.identity.people.business.-,com.mysms.identity.people.repository.-,com.mysms.identity.people.domain.-,com.mysms.identity.people.model.-,com.mysms.identity.people.mapper.-,com.mysms.identity.people.validation.-,com.mysms.identity.people.errors.-,com.mysms.identity.people.events.-,com.mysms.identity.people.config.-,com.mysms.identity.people.constants.-</mysms.spotbugs.onlyAnalyze>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>auth-client</artifactId>
    </dependency>
    <!-- privacy's rights-request tasks and retention runs (PrivacyTaskHandler) -->
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>privacy-client</artifactId>
    </dependency>
    <dependency>
      <groupId>org.mapstruct</groupId>
      <artifactId>mapstruct</artifactId>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- argon2id password hashing (Spring Security's Argon2PasswordEncoder runs on Bouncy Castle) -->
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
    </dependency>
    <!-- messaging runtime relay; event consumers compile against its narrow API -->
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>messaging</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-mail</artifactId>
    </dependency>
    <dependency>
      <groupId>com.icegreen</groupId>
      <artifactId>greenmail</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>core</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>auth-client</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>privacy-client</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- each area's migrations, from the single source of truth, applied to its own schema only -->
      <resource>
        <directory>${mysms.migrations.dir}/iam</directory>
        <targetPath>db/migration/iam</targetPath>
      </resource>
      <resource>
        <directory>${mysms.migrations.dir}/people</directory>
        <targetPath>db/migration/people</targetPath>
      </resource>
    </resources>
    <plugins>
      <!-- its protos (src/main/resources/proto: its areas' own, and copies of the callees' they call) into its jar -->
      <plugin>
        <groupId>org.xolstice.maven.plugins</groupId>
        <artifactId>protobuf-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.mysms.identity.IdentityApplication</mainClass>
          <classifier>exec</classifier>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
