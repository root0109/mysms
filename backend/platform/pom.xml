<?xml version="1.0" encoding="UTF-8"?>
<!--
  platform: the Platform and Tenancy microservice, owner of database schema "platform" (JAVA-CODING-RULES §2).
  Depends on core, auth-client and the messaging runtime; only event consumers compile against the
  narrow messaging API. Produces a plain jar (assembled by `app`) and an executable microservice jar (classifier exec).
  Its Flyway migrations are database/migrations/platform, applied to its own schema only.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.mysms</groupId>
    <artifactId>mysms</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>platform</artifactId>
  <name>MySMS platform</name>
  <description>Platform and Tenancy microservice (schema platform)</description>

  <dependencies>
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>auth-client</artifactId>
    </dependency>
    <!-- privacy's rights-request tasks and retention runs (PrivacyTaskHandler, design PRIVACY-AND-CONSENT-CENTRE §9.1) -->
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>privacy-client</artifactId>
    </dependency>
    <!-- the file store: Google Cloud Storage with V4 signed URLs (business/GcsFileStore) -->
    <dependency>
      <groupId>com.google.cloud</groupId>
      <artifactId>google-cloud-storage</artifactId>
    </dependency>
    <dependency>
      <groupId>org.mapstruct</groupId>
      <artifactId>mapstruct</artifactId>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- messaging runtime relay; event consumers compile against its narrow API -->
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>messaging</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>core</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>auth-client</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>privacy-client</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- the file store's component tests run against a real GCS emulator (fsouza/fake-gcs-server) -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- the module's own migrations, from the single source of truth -->
      <resource>
        <directory>${mysms.migrations.dir}/platform</directory>
        <targetPath>db/migration/platform</targetPath>
      </resource>
    </resources>
    <plugins>
      <!-- its protos (src/main/resources/proto: its own, and copies of the callees' it calls) into its jar -->
      <plugin>
        <groupId>org.xolstice.maven.plugins</groupId>
        <artifactId>protobuf-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.mysms.platform.PlatformApplication</mainClass>
          <classifier>exec</classifier>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
