<?xml version="1.0" encoding="UTF-8"?>
<!--
  platform: the Platform microservice (docs/design/MODULE-AND-PRODUCT-REORGANISATION.md §3). Its areas "platform", "master", "org" each own
  their database schema of the same name, contract (com.mysms.<area>.v1, /v1/<area>), operation table and Flyway
  history (database/migrations/<area>); inside the module they share one process, one jar and one gRPC server.
  Depends on core, auth-client and the messaging runtime; only event consumers compile against the narrow messaging
  API. Produces a plain jar (assembled by `app`) and an executable microservice jar (classifier exec).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.mysms</groupId>
    <artifactId>mysms</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>platform</artifactId>
  <name>MySMS platform</name>
  <description>Platform microservice (schemas platform, master, org)</description>

  <properties>
    <!-- SpotBugs analyses the module's own code: its root package and every layer package of each area (§3) -->
    <mysms.spotbugs.onlyAnalyze>com.mysms.platform.*,com.mysms.platform.api.-,com.mysms.platform.controller.-,com.mysms.platform.grpc.-,com.mysms.platform.integration.-,com.mysms.platform.business.-,com.mysms.platform.repository.-,com.mysms.platform.domain.-,com.mysms.platform.model.-,com.mysms.platform.mapper.-,com.mysms.platform.validation.-,com.mysms.platform.errors.-,com.mysms.platform.events.-,com.mysms.platform.config.-,com.mysms.platform.constants.-,com.mysms.platform.master.*,com.mysms.platform.master.api.-,com.mysms.platform.master.controller.-,com.mysms.platform.master.grpc.-,com.mysms.platform.master.integration.-,com.mysms.platform.master.business.-,com.mysms.platform.master.repository.-,com.mysms.platform.master.domain.-,com.mysms.platform.master.model.-,com.mysms.platform.master.mapper.-,com.mysms.platform.master.validation.-,com.mysms.platform.master.errors.-,com.mysms.platform.master.events.-,com.mysms.platform.master.config.-,com.mysms.platform.master.constants.-,com.mysms.platform.org.*,com.mysms.platform.org.api.-,com.mysms.platform.org.controller.-,com.mysms.platform.org.grpc.-,com.mysms.platform.org.integration.-,com.mysms.platform.org.business.-,com.mysms.platform.org.repository.-,com.mysms.platform.org.domain.-,com.mysms.platform.org.model.-,com.mysms.platform.org.mapper.-,com.mysms.platform.org.validation.-,com.mysms.platform.org.errors.-,com.mysms.platform.org.events.-,com.mysms.platform.org.config.-,com.mysms.platform.org.constants.-</mysms.spotbugs.onlyAnalyze>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>auth-client</artifactId>
    </dependency>
    <!-- privacy's rights-request tasks and retention runs (PrivacyTaskHandler) -->
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>privacy-client</artifactId>
    </dependency>
    <dependency>
      <groupId>org.mapstruct</groupId>
      <artifactId>mapstruct</artifactId>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- messaging runtime relay; event consumers compile against its narrow API -->
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>messaging</artifactId>
    </dependency>
    <dependency>
      <groupId>com.google.cloud</groupId>
      <artifactId>google-cloud-storage</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>core</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>auth-client</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>privacy-client</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- each area's migrations, from the single source of truth, applied to its own schema only -->
      <resource>
        <directory>${mysms.migrations.dir}/platform</directory>
        <targetPath>db/migration/platform</targetPath>
      </resource>
      <resource>
        <directory>${mysms.migrations.dir}/master</directory>
        <targetPath>db/migration/master</targetPath>
      </resource>
      <resource>
        <directory>${mysms.migrations.dir}/org</directory>
        <targetPath>db/migration/org</targetPath>
      </resource>
    </resources>
    <plugins>
      <!-- its protos (src/main/resources/proto: its areas' own, and copies of the callees' they call) into its jar -->
      <plugin>
        <groupId>org.xolstice.maven.plugins</groupId>
        <artifactId>protobuf-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.mysms.platform.PlatformApplication</mainClass>
          <classifier>exec</classifier>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
