<?xml version="1.0" encoding="UTF-8"?>
<!--
  hrms: the Hrms microservice (docs/design/MODULE-AND-PRODUCT-REORGANISATION.md §3). Its areas "hr", "payroll" each own
  their database schema of the same name, contract (com.mysms.<area>.v1, /v1/<area>), operation table and Flyway
  history (database/migrations/<area>); inside the module they share one process, one jar and one gRPC server.
  Depends on core, auth-client and the messaging runtime; only event consumers compile against the narrow messaging
  API. Produces a plain jar (assembled by `app`) and an executable microservice jar (classifier exec).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.mysms</groupId>
    <artifactId>mysms</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>hrms</artifactId>
  <name>MySMS hrms</name>
  <description>Hrms microservice (schemas hr, payroll)</description>

  <properties>
    <!-- SpotBugs analyses the module's own code: its root package and every layer package of each area (§3) -->
    <mysms.spotbugs.onlyAnalyze>com.mysms.hrms.*,com.mysms.hrms.hr.*,com.mysms.hrms.hr.api.-,com.mysms.hrms.hr.controller.-,com.mysms.hrms.hr.grpc.-,com.mysms.hrms.hr.integration.-,com.mysms.hrms.hr.business.-,com.mysms.hrms.hr.repository.-,com.mysms.hrms.hr.domain.-,com.mysms.hrms.hr.model.-,com.mysms.hrms.hr.mapper.-,com.mysms.hrms.hr.validation.-,com.mysms.hrms.hr.errors.-,com.mysms.hrms.hr.events.-,com.mysms.hrms.hr.config.-,com.mysms.hrms.hr.constants.-,com.mysms.hrms.payroll.*,com.mysms.hrms.payroll.api.-,com.mysms.hrms.payroll.controller.-,com.mysms.hrms.payroll.grpc.-,com.mysms.hrms.payroll.integration.-,com.mysms.hrms.payroll.business.-,com.mysms.hrms.payroll.repository.-,com.mysms.hrms.payroll.domain.-,com.mysms.hrms.payroll.model.-,com.mysms.hrms.payroll.mapper.-,com.mysms.hrms.payroll.validation.-,com.mysms.hrms.payroll.errors.-,com.mysms.hrms.payroll.events.-,com.mysms.hrms.payroll.config.-,com.mysms.hrms.payroll.constants.-</mysms.spotbugs.onlyAnalyze>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>auth-client</artifactId>
    </dependency>
    <!-- privacy's rights-request tasks and retention runs (PrivacyTaskHandler) -->
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>privacy-client</artifactId>
    </dependency>
    <dependency>
      <groupId>org.mapstruct</groupId>
      <artifactId>mapstruct</artifactId>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- messaging runtime relay; event consumers compile against its narrow API -->
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>messaging</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>core</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>auth-client</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.mysms</groupId>
      <artifactId>privacy-client</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- each area's migrations, from the single source of truth, applied to its own schema only -->
      <resource>
        <directory>${mysms.migrations.dir}/hr</directory>
        <targetPath>db/migration/hr</targetPath>
      </resource>
      <resource>
        <directory>${mysms.migrations.dir}/payroll</directory>
        <targetPath>db/migration/payroll</targetPath>
      </resource>
    </resources>
    <plugins>
      <!-- its protos (src/main/resources/proto: its areas' own, and copies of the callees' they call) into its jar -->
      <plugin>
        <groupId>org.xolstice.maven.plugins</groupId>
        <artifactId>protobuf-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.mysms.hrms.HrmsApplication</mainClass>
          <classifier>exec</classifier>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
