        <mxCell id="p0-16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="p0-5" target="p0-7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="240" y="390"/><mxPoint x="840" y="390"/></Array></mxGeometry></mxCell>
        <mxCell id="p0-17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p0-6" target="p0-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p0-18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p0-6" target="p0-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p0-19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p0-7" target="p0-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p0-20" value="reads sources, POMs, protos, migrations" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="p0-9" target="p0-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p0-21" value="&lt;b&gt;Rules enforced by the build&lt;/b&gt;&lt;br&gt;- A domain module never depends on another domain module (A1); it may not import RabbitMQ, Pub/Sub or messaging runtime types.&lt;br&gt;- A module&#x27;s migrations live in database/migrations/&amp;lt;module&amp;gt; and touch only its own schema (§14).&lt;br&gt;- A module imports only the gRPC contracts of modules in its row of ARCHITECTURE.md §2 (core test kit ModuleChecks; conformance G1)." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fffbe6;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="750" width="840" height="110" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
