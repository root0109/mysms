        <mxCell id="p0-13" value="runtime; compile only for the event API&lt;br&gt;(EventEnvelope, EventHandler, EventSubscriptions, RejectedEventException)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p0-4" target="p0-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p0-14" value="compile" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="p0-4" target="p0-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
