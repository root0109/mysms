<mxfile host="drawio" type="device">
  <diagram id="d0" name="Build modules (Maven)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p0-2" value="Build modules and the dependencies a domain module may have (conformance ModuleBoundaryRule A1)" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1300" height="30" as="geometry"/></mxCell>
        <mxCell id="p0-3" value="&lt;b&gt;app&lt;/b&gt;&lt;br&gt;assembly only: all 22 domain modules, one process" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="560" y="70" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="p0-4" value="&lt;b&gt;22 domain modules&lt;/b&gt; (one schema each)&lt;br&gt;master, platform, iam, org, people, academics, sis, hr, payroll, admission, attendance, facility, timetable, assessment, lms, finance, library, transport, comms, frontoffice, careers, privacy&lt;br&gt;each: own @SpringBootApplication, library jar + executable service jar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="380" y="200" width="660" height="90" as="geometry"/></mxCell>
        <mxCell id="p0-5" value="&lt;b&gt;auth-client&lt;/b&gt;&lt;br&gt;edge filter + gRPC interceptor, token verification, permissions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="120" y="420" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="p0-6" value="&lt;b&gt;privacy-client&lt;/b&gt;&lt;br&gt;consent checks over gRPC&lt;br&gt;(used by people)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="420" y="420" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="p0-7" value="&lt;b&gt;messaging&lt;/b&gt;&lt;br&gt;EventBus API, EventRuntime, RabbitMQ / Pub/Sub / in-process adapters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="720" y="420" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="p0-8" value="&lt;b&gt;core&lt;/b&gt;&lt;br&gt;AppTransactionManager, ModuleDatabase, tenancy, errors, paging, ids, outbox writer, idempotency, jobs, partitions, gRPC edge, tracing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="420" y="620" width="540" height="80" as="geometry"/></mxCell>
        <mxCell id="p0-9" value="&lt;b&gt;conformance&lt;/b&gt;&lt;br&gt;build-time rule checks (module boundaries, gRPC, technology)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="1100" y="420" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="p0-10" value="compile (all 22)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p0-3" target="p0-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p0-11" value="compile" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p0-4" target="p0-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
