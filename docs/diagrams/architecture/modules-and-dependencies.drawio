        <mxCell id="p1-52" value="&lt;b&gt;How to read&lt;/b&gt;&lt;br&gt;- One box = one module = one PostgreSQL schema it alone reads and writes.&lt;br&gt;- Rows are layers of the allowed-dependency DAG (ARCHITECTURE.md §2): callers above callees.&lt;br&gt;- Solid arrow: the caller&#x27;s integration/&amp;lt;Callee&amp;gt;GrpcClient; label = distinct RPCs it uses.&lt;br&gt;- Dashed: the shared privacy-client library calling privacy.&lt;br&gt;- Not drawn: every module calls iam&#x27;s IamAuthzService.GetRolePermissions through auth-client (permission cache misses)." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fffbe6;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1270" y="70" width="280" height="330" as="geometry"/></mxCell>
        <mxCell id="p1-53" value="&lt;b&gt;Most called&lt;/b&gt;&lt;br&gt;iam: 7 callers&lt;br&gt;sis: 4 callers&lt;br&gt;org: 4 callers&lt;br&gt;academics: 3 callers&lt;br&gt;&lt;br&gt;Heaviest edge: admission → sis (14 RPCs, creates the student on enrolment)" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fffbe6;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1270" y="420" width="280" height="200" as="geometry"/></mxCell>
        <mxCell id="p1-54" value="2" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1-10" target="p1-19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p1-55" value="3" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1-10" target="p1-22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
