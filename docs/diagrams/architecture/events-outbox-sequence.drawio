        <mxCell id="p0-29" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=50;height=20;fillColor=none;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="10" y="786" width="1670" height="186" as="geometry"/></mxCell>
        <mxCell id="p0-30" value="[already processed]" style="text;html=1;align=left;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="66" y="787" width="480" height="18" as="geometry"/></mxCell>
        <mxCell id="p0-31" value="ack" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=8;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="950" y="1000" as="sourcePoint"/><mxPoint x="740" y="1000" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p0-32" value="ROLLBACK; note processing_error (WARN)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1160" y="1068" as="sourcePoint"/><mxPoint x="1580" y="1068" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p0-33" value="RabbitMQ: returned after 1 s, 2 s, 4 s … 60 s" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=8;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="950" y="1100" as="sourcePoint"/><mxPoint x="740" y="1100" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p0-34" value="after 5 returns (delivery-limit):&lt;br&gt;mysms.&amp;lt;b&amp;gt;.dead; fix the cause,&lt;br&gt;then EventsAdmin replay-dead" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="648" y="1118" width="184" height="54" as="geometry"/></mxCell>
        <mxCell id="p0-35" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=50;height=20;fillColor=none;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="10" y="1024" width="1670" height="160" as="geometry"/></mxCell>
        <mxCell id="p0-36" value="[handler fails]" style="text;html=1;align=left;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="66" y="1025" width="480" height="18" as="geometry"/></mxCell>
        <mxCell id="p0-45" value="&lt;b&gt;Guarantees&lt;/b&gt;&lt;br&gt;- No distributed transactions: the outbox row commits with the change.&lt;br&gt;- A crash after publish only republishes; the inbox key (tenant, event id) makes handling exactly once.&lt;br&gt;- Events published before a consumer queue exists wait in mysms.events.unrouted (3 days; replay-unrouted).&lt;br&gt;- Global master-data events carry no tenant and skip the inbox; their handlers are idempotent.&lt;br&gt;- /actuator/health &#x27;events&#x27; is DOWN when the broker is lost or a relay fails 3 passes in a row.&lt;br&gt;- Pub/Sub: retries 10 s to 60 s, 5 attempts, then &amp;lt;consumer&amp;gt;-dead." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fffbe6;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1710" y="140" width="380" height="250" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
