<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" type="device">
  <diagram id="d0" name="Monolith (one process)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p0-2" value="Deployment A: the monolith (app jar): every module in one JVM, still one pool and one Flyway history per module" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1300" height="30" as="geometry"/></mxCell>
        <mxCell id="p0-3" value="Browsers and apps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="170" height="60" as="geometry"/></mxCell>
        <mxCell id="p0-4" value="Reverse proxy / load balancer&lt;br&gt;TLS, one origin:&lt;br&gt;static web apps, /v1/, /oauth2/jwks&lt;br&gt;(/oauth2/token not routed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="270" y="70" width="230" height="110" as="geometry"/></mxCell>
        <mxCell id="p0-5" value="JVM: app-0.1.0-SNAPSHOT-exec.jar" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="560" y="50" width="520" height="560" as="geometry"/></mxCell>
        <mxCell id="p0-6" value="HTTP :8080 (PORT) - REST edge: TraceFilter, AuthFilter, IdempotencyFilter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="590" y="90" width="460" height="60" as="geometry"/></mxCell>
        <mxCell id="p0-7" value="gRPC :9112 (MYSMS_GRPC_SERVER_PORT) + in-process server &#x27;mysms&#x27;&lt;br&gt;module-to-module calls stay in-process" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="590" y="160" width="460" height="60" as="geometry"/></mxCell>
        <mxCell id="p0-8" value="22 modules (master … privacy)&lt;br&gt;each: ModuleDatabase = primary pool + optional replica pool,&lt;br&gt;own Flyway history &amp;lt;schema&amp;gt;.flyway_schema_history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="590" y="230" width="460" height="70" as="geometry"/></mxCell>
        <mxCell id="p0-9" value="EventRuntime&lt;br&gt;one relay loop over all module outboxes (&#x27;outbox-relay&#x27;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="590" y="310" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="p0-10" value="JobRuntime (&#x27;scheduled-jobs&#x27;)&lt;br&gt;PartitionMaintenanceJob" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="830" y="310" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="p0-11" value="Monolith publishes for every module as one broker user (publisher-user = self)" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fffbe6;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="590" y="400" width="460" height="50" as="geometry"/></mxCell>
        <mxCell id="p0-12" value="PostgreSQL primary&lt;br&gt;database mysms&lt;br&gt;22 schemas, FORCE RLS" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="600" y="680" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="p0-13" value="Streaming replica&lt;br&gt;(optional)&lt;br&gt;read-only transactions" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="900" y="680" width="200" height="130" as="geometry"/></mxCell>
        <mxCell id="p0-14" value="RabbitMQ vhost mysms&lt;br&gt;exchange mysms.events (topic)&lt;br&gt;queues mysms.&amp;lt;module&amp;gt;.events&lt;br&gt;mysms.&amp;lt;module&amp;gt;.dead&lt;br&gt;mysms.events.unrouted&lt;br&gt;&lt;br&gt;or MYSMS_EVENTS_BUS=in-process" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1170" y="300" width="260" height="150" as="geometry"/></mxCell>
        <mxCell id="p0-15" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p0-3" target="p0-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p0-16" value="/v1, /oauth2/jwks" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p0-4" target="p0-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p0-17" value="writes + primary reads&lt;br&gt;(mysms_app, RLS)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;" edge="1" parent="1" source="p0-8" target="p0-12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p0-18" value="read-only transactions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.8;exitY=1;dashed=1;" edge="1" parent="1" source="p0-8" target="p0-13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p0-19" value="streaming replication" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="p0-12" target="p0-13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p0-20" value="outbox/inbox only&lt;br&gt;(mysms_relay, BYPASSRLS)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.2;exitY=1;entryX=0.2;entryY=0;" edge="1" parent="1" source="p0-9" target="p0-12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p0-21" value="publish (confirmed)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;" edge="1" parent="1" source="p0-9" target="p0-14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p0-22" value="deliver to inbox" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;entryX=1;entryY=0.75;" edge="1" parent="1" source="p0-14" target="p0-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p0-23" value="&lt;b&gt;Database roles&lt;/b&gt; (created by operations, DEPLOYMENT.md §2.1)&lt;br&gt;- mysms_migrate: owns schemas; Flyway at startup, partition maintenance.&lt;br&gt;- mysms_app: runtime login, not the owner, so FORCE RLS binds it; DML grants only.&lt;br&gt;- mysms_relay: BYPASSRLS; SELECT/DELETE on outbox_event and inbox_event, UPDATE of outbox_event.published_at and publish_error only.&lt;br&gt;&lt;br&gt;Pools: 22 × MYSMS_&amp;lt;MODULE&amp;gt;_DB_POOL_SIZE (default 10) must fit max_connections." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fffbe6;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="500" height="200" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="d1" name="Per-module services">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p1-2" value="Deployment B: one service per module (Kubernetes), same jars and configuration keys" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="30" as="geometry"/></mxCell>
        <mxCell id="p1-3" value="Browsers and apps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="170" height="60" as="geometry"/></mxCell>
        <mxCell id="p1-4" value="Gateway / ingress&lt;br&gt;routes /v1/&amp;lt;module&amp;gt;/ to that service,&lt;br&gt;/oauth2/jwks to iam;&lt;br&gt;/oauth2/token internal only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="270" y="60" width="250" height="130" as="geometry"/></mxCell>
        <mxCell id="p1-5" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1-3" target="p1-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p1-6" value="&lt;b&gt;iam-service&lt;/b&gt;&lt;br&gt;issues person and service tokens, JWKS&lt;br&gt;HTTP PORT, gRPC 9112&lt;br&gt;own pool(s), Flyway, relay, job runtime&lt;br&gt;broker user mysms-iam" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="640" y="60" width="330" height="130" as="geometry"/></mxCell>
        <mxCell id="p1-7" value="/v1/iam/" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1-4" target="p1-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p1-8" value="&lt;b&gt;sis-service&lt;/b&gt;&lt;br&gt;calls academics, iam, org, people&lt;br&gt;HTTP PORT, gRPC 9112&lt;br&gt;own pool(s), Flyway, relay, job runtime&lt;br&gt;broker user mysms-sis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="640" y="230" width="330" height="130" as="geometry"/></mxCell>
        <mxCell id="p1-9" value="/v1/sis/" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1-4" target="p1-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p1-10" value="&lt;b&gt;finance-service&lt;/b&gt;&lt;br&gt;calls academics, iam, master, org, sis&lt;br&gt;HTTP PORT, gRPC 9112&lt;br&gt;own pool(s), Flyway, relay, job runtime&lt;br&gt;broker user mysms-finance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="640" y="400" width="330" height="130" as="geometry"/></mxCell>
        <mxCell id="p1-11" value="/v1/finance/" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1-4" target="p1-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p1-12" value="&lt;b&gt;… 19 more-service&lt;/b&gt;&lt;br&gt;one per module&lt;br&gt;HTTP PORT, gRPC 9112&lt;br&gt;own pool(s), Flyway, relay, job runtime&lt;br&gt;broker user mysms-&amp;lt;module&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="640" y="570" width="330" height="130" as="geometry"/></mxCell>
        <mxCell id="p1-13" value="/v1/&amp;lt;module&amp;gt;/" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1-4" target="p1-12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p1-14" value="gRPC (dns:///iam-service.&amp;lt;ns&amp;gt;…:9112)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=1;entryY=0.7;" edge="1" parent="1" source="p1-8" target="p1-6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1010" y="268"/><mxPoint x="1010" y="148"/></Array></mxGeometry></mxCell>
        <mxCell id="p1-15" value="gRPC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=1;entryY=0.7;" edge="1" parent="1" source="p1-10" target="p1-8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1010" y="438"/><mxPoint x="1010" y="318"/></Array></mxGeometry></mxCell>
        <mxCell id="p1-16" value="PostgreSQL (shared instance)&lt;br&gt;one schema per service&lt;br&gt;or MYSMS_&amp;lt;MODULE&amp;gt;_DB_URL → own instance" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1110" y="60" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="p1-17" value="Replica per instance (optional)&lt;br&gt;MYSMS_&amp;lt;MODULE&amp;gt;_DB_REPLICA_URL" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1110" y="230" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="p1-18" value="RabbitMQ (or Pub/Sub)&lt;br&gt;one broker user per service;&lt;br&gt;topic permissions: publish only&lt;br&gt;&amp;lt;module&amp;gt;.* and audit.recorded;&lt;br&gt;consumer checks the AMQP user-id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1110" y="420" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="p1-19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d6b656;endArrow=none;endFill=0;" edge="1" parent="1" source="p1-6" target="p1-16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p1-20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d6b656;endArrow=none;endFill=0;" edge="1" parent="1" source="p1-8" target="p1-16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p1-21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d6b656;endArrow=none;endFill=0;" edge="1" parent="1" source="p1-10" target="p1-16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p1-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d6b656;endArrow=none;endFill=0;" edge="1" parent="1" source="p1-12" target="p1-16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p1-23" value="replication" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="p1-16" target="p1-17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p1-24" value="events" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#9673a6;startArrow=block;startFill=1;" edge="1" parent="1" source="p1-12" target="p1-18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p1-25" value="&lt;b&gt;What changes between A and B&lt;/b&gt;&lt;br&gt;- Only configuration: same jars, same schemas, same SQL.&lt;br&gt;- gRPC targets: in-process in A; Kubernetes DNS name or MYSMS_&amp;lt;MODULE&amp;gt;_GRPC_ADDRESS in B.&lt;br&gt;- Broker identity: one user (self) in A; mysms-&amp;lt;module&amp;gt; per service in B.&lt;br&gt;- Each service verifies tokens itself against iam&#x27;s JWKS; MYSMS_AUTH_ISSUER is the same public URL everywhere.&lt;br&gt;- Moving a module to its own database: point MYSMS_&amp;lt;MODULE&amp;gt;_DB_* elsewhere and copy its schema (no cross-schema FKs)." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fffbe6;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="560" height="220" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
