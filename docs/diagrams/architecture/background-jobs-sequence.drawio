<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" type="device">
  <diagram id="d0" name="Per-tenant scheduled job">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="964" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p0-26" value="Business service&lt;br&gt;(e.g. privacy ConsentService)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=56;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="180" height="864" as="geometry"/></mxCell>
        <mxCell id="p0-27" value="JobSchedule&lt;br&gt;&amp;lt;module&amp;gt;.job_schedule&lt;br&gt;(no RLS)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=56;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="270" y="60" width="180" height="864" as="geometry"/></mxCell>
        <mxCell id="p0-28" value="JobRuntime&lt;br&gt;(&#x27;scheduled-jobs&#x27; thread)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=56;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="520" y="60" width="180" height="864" as="geometry"/></mxCell>
        <mxCell id="p0-29" value="ScheduledJob&lt;br&gt;(e.g. privacy MajorityJob,&lt;br&gt;ConsentExpiryJob)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=56;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="770" y="60" width="180" height="864" as="geometry"/></mxCell>
        <mxCell id="p0-30" value="Module database&lt;br&gt;(tenant tables, RLS)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=56;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1020" y="60" width="180" height="864" as="geometry"/></mxCell>
        <mxCell id="p0-2" value="Background jobs: enrolment by work, leased per-tenant runs (core com.mysms.core.jobs)" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1800" height="30" as="geometry"/></mxCell>
        <mxCell id="p0-3" value="enrol(jobCode, now) inside the caller&#x27;s transaction:&lt;br&gt;INSERT … ON CONFLICT (job_code, tenant_id) DO NOTHING" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="176" as="sourcePoint"/><mxPoint x="360" y="176" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p0-4" value="tenant now due (next_run_at = now);&lt;br&gt;a tenant without work never runs" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="268" y="194" width="184" height="40" as="geometry"/></mxCell>
        <mxCell id="p0-5" value="claim(owner, this process&#x27;s job codes, now, now + lease, 1)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="610" y="296" as="sourcePoint"/><mxPoint x="360" y="296" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p0-6" value="global tx: UPDATE … SET lease_owner, lease_until&lt;br&gt;WHERE due AND lease free ORDER BY next_run_at&lt;br&gt;LIMIT 1 FOR UPDATE SKIP LOCKED RETURNING" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="210" y="314" width="300" height="54" as="geometry"/></mxCell>
        <mxCell id="p0-7" value="claim (job code, tenant, failures) or none" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;endSize=8;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="394" as="sourcePoint"/><mxPoint x="610" y="394" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p0-8" value="bind CallContext(tenant,&lt;br&gt;no actor, new trace)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="518" y="448" width="184" height="40" as="geometry"/></mxCell>
        <mxCell id="p0-9" value="run()" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="610" y="514" as="sourcePoint"/><mxPoint x="860" y="514" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p0-10" value="doInWriteTransaction: set_config(&#x27;app.tenant_id&#x27;),&lt;br&gt;work, outbox events, COMMIT" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="596" as="sourcePoint"/><mxPoint x="1110" y="596" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p0-11" value="loop" style="shape=umlFrame;whiteSpace=wrap;html=1;width=50;height=20;fillColor=none;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="34" y="538" width="1152" height="76" as="geometry"/></mxCell>
        <mxCell id="p0-12" value="[bounded batches: one person or decision per transaction]" style="text;html=1;align=left;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="90" y="539" width="480" height="18" as="geometry"/></mxCell>
        <mxCell id="p0-13" value="complete: next_run_at = now + job interval, failures = 0,&lt;br&gt;clear lease (only while this runner holds it)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="610" y="692" as="sourcePoint"/><mxPoint x="360" y="692" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p0-14" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="34" y="708" as="sourcePoint"/><mxPoint x="1186" y="708" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p0-15" value="[run threw]" style="text;html=1;align=left;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="38" y="710" width="360" height="18" as="geometry"/></mxCell>
        <mxCell id="p0-16" value="fail: next_run_at = now + min(poll × 2^failures, job interval),&lt;br&gt;failures + 1, last_error; clear lease" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="610" y="766" as="sourcePoint"/><mxPoint x="360" y="766" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p0-17" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=50;height=20;fillColor=none;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="34" y="634" width="1152" height="150" as="geometry"/></mxCell>
        <mxCell id="p0-18" value="[run finished]" style="text;html=1;align=left;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="90" y="635" width="480" height="18" as="geometry"/></mxCell>
        <mxCell id="p0-19" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="22" y="796" as="sourcePoint"/><mxPoint x="1198" y="796" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="p0-20" value="[nothing due]" style="text;html=1;align=left;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="26" y="798" width="360" height="18" as="geometry"/></mxCell>
        <mxCell id="p0-21" value="next module" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="518" y="826" width="184" height="26" as="geometry"/></mxCell>
        <mxCell id="p0-22" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;width=50;height=20;fillColor=none;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="22" y="418" width="1176" height="446" as="geometry"/></mxCell>
        <mxCell id="p0-23" value="[claimed]" style="text;html=1;align=left;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="78" y="419" width="480" height="18" as="geometry"/></mxCell>
        <mxCell id="p0-24" value="loop" style="shape=umlFrame;whiteSpace=wrap;html=1;width=50;height=20;fillColor=none;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="10" y="252" width="1200" height="626" as="geometry"/></mxCell>
        <mxCell id="p0-25" value="[every mysms.jobs.poll-interval (1m); per module, up to mysms.jobs.batch-size (20) runs]" style="text;html=1;align=left;fontSize=10;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="66" y="253" width="480" height="18" as="geometry"/></mxCell>
        <mxCell id="p0-31" value="&lt;b&gt;Properties&lt;/b&gt;&lt;br&gt;- One run per tenant and job across replicas: the lease is taken with SKIP LOCKED.&lt;br&gt;- A crashed runner&#x27;s lease (mysms.jobs.lease, 30m) expires and another replica takes the run over; runs must be safe to repeat.&lt;br&gt;- One tenant&#x27;s failure never stops another tenant&#x27;s run.&lt;br&gt;- mysms.jobs.enabled=false on a replica: it runs no jobs, others do.&lt;br&gt;- Job code: &amp;lt;module&amp;gt;.&amp;lt;name&amp;gt;; interval per job (privacy: 1h by default)." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fffbe6;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1240" y="140" width="400" height="260" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
